{
  "name": "oneself",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "knip": "knip",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run boundaries && pnpm run knip"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "9.39.5",
    "knip": "6.40.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
