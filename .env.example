# 生产 Compose 和宿主机进程共用这份变量。复制成 .env 后再填真实值。
# .env 被 gitignore，这个示例可以提交。这里的口令和密钥都是占位，不能拿去当生产配置。
# 注释必须单独成行。写在值后面的 # 会被 Compose 当成值的一部分。

# 同一时间只启用一个入口。可选 cloudflared、caddy、tailscale。
# 默认 cloudflared，所以普通的 docker compose up 就带上隧道。
# 换成另外两个时只改这里，不改应用镜像。三个入口都是 profile，避免同时起来形成两个公网源。
COMPOSE_PROFILES=cloudflared

# 唯一对外源，必须带协议，例如 https://自己的域名 或 https://机器名.tailnet.ts.net。
# 发现文档、OAuth issuer、批准地址和媒体绝对地址只使用它，不从请求的 Host 或转发头现推。
# 它是 HTTPS 时，所属人 Cookie 加 Secure。管理端写请求的 Origin 必须等于它。
# 没有这个变量时，进程只接受本机开发源，不以公网入口启动。
PUBLIC_ORIGIN=https://example.invalid

# 第一次启动且还没有所属人时，用 OWNER_LOGIN 创建唯一所属人。账号已存在后，启动不再用它登录或重置。
OWNER_LOGIN=owner

# 第一次启动时的所属人初始口令。只存 Argon2id 哈希，并强制下次登录改密。
# 没有所属人且没有这个变量时，应用拒绝启动。启动时不生成 API Key。
# 忘记密码时另设一次性的 OWNER_RESET_PASSWORD，重启后替换哈希并再次强制改密，用完必须删掉。没有邮箱重置。
OWNER_PASSWORD=change-me

# PostgreSQL 的 oneself 用户口令。生产库只在 Compose 网络内，不映射宿主机端口。
# 应用里的连接串由 Compose 拼成 postgres://oneself:<这个口令>@postgres:5432/oneself。
POSTGRES_PASSWORD=change-me

# RustFS 的访问密钥。应用把它当作 S3 access key。不要用开发 compose 里的本机密钥。
RUSTFS_ACCESS_KEY=change-me

# RustFS 的秘密密钥。应用把它当作 S3 secret key。只放在 .env，不写进镜像或仓库。
RUSTFS_SECRET_KEY=change-me

# 对象桶名。启动时若不存在就创建。Markdown、原件和站点 release 都在这一个桶里，用键前缀分开。
OBJECT_STORAGE_BUCKET=oneself

# S3 区域。RustFS 不按区域选址，但 AWS SDK 要求有这个值。单盘部署保持 us-east-1。
OBJECT_STORAGE_REGION=us-east-1

# 应用镜像。生产用已发布的版本号标签。本地没有远程镜像时才用 oneself:local。不要用 latest。
ONESELF_IMAGE=oneself:local

# cloudflared 镜像。必须写死标签，不用 latest。只在 COMPOSE_PROFILES=cloudflared 时启动。
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2025.8.1

# Caddy 镜像。只在 COMPOSE_PROFILES=caddy 时启动。证书在本机申请，80 和 443 必须能从公网到达。
CADDY_IMAGE=caddy:2.11.7-alpine

# Tailscale 镜像。只在 COMPOSE_PROFILES=tailscale 时启动。容器用 userspace networking，只做 Serve，不开 Funnel。
TAILSCALE_IMAGE=tailscale/tailscale:v1.86.2

# Cloudflare Tunnel 的令牌。只给 cloudflared。没有它时入口容器可以失败，应用和数据库仍然留在。
TUNNEL_TOKEN=

# Caddy 的主机名，例如 oneself.example.com。只给 caddy。发现地址仍然以 PUBLIC_ORIGIN 为准，不要另写一个公网源。
APP_DOMAIN=

# Let's Encrypt 账户邮箱。只给 caddy，用来申请和续期证书。
ACME_EMAIL=

# Tailscale 一次性 auth key。只给 tailscale。状态放在卷里。没有它时入口可以失败，不要为此把数据库端口映射出去。
TAILSCALE_AUTHKEY=
